<!-- Custom Scrollbar CSS -->
<style>
/* Scrollbar personalizado para contenedores */
.custom-scrollbar {
  position: relative;
  overflow: hidden;
}

.custom-scrollbar .scroll-content {
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  /* NO padding-right para evitar que se mueva el contenido */
  box-sizing: border-box;
}

.custom-scrollbar .scrollbar {
  position: absolute;
  right: 2px; /* Pequeño margen del borde */
  top: 0;
  width: 6px; /* Más delgado */
  height: 100%;
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 3px;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none; /* No interfiere con el contenido */
}

.custom-scrollbar .scrollbar-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 30px;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 3px;
  cursor: pointer;
  transition: background-color 0.3s ease;
  pointer-events: auto; /* Solo el thumb responde a eventos */
}

.custom-scrollbar .scrollbar-thumb:hover {
  background-color: rgba(0, 0, 0, 0.5);
}

.custom-scrollbar:hover .scrollbar {
  opacity: 1;
}

/* Ocultar scrollbar nativo en webkit */
.custom-scrollbar .scroll-content::-webkit-scrollbar {
  width: 0px;
  background: transparent;
}

.custom-scrollbar .scroll-content::-webkit-scrollbar-thumb {
  background: transparent;
}

.custom-scrollbar .scroll-content::-webkit-scrollbar-track {
  background: transparent;
}

/* Scrollbar personalizado para el body */
body::-webkit-scrollbar {
  width: 12px;
}

body::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.05);
  border-radius: 6px;
}

body::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 6px;
  border: 2px solid transparent;
  background-clip: content-box;
}

body::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 0, 0, 0.4);
  background-clip: content-box;
}

/* Scrollbar para Firefox */
body {
  scrollbar-width: thin;
  scrollbar-color: rgba(0, 0, 0, 0.2) rgba(0, 0, 0, 0.05);
}

/* Scrollbar para elementos específicos */
.post-body::-webkit-scrollbar,
.widget-content::-webkit-scrollbar,
.comments-content::-webkit-scrollbar {
  width: 8px;
}

.post-body::-webkit-scrollbar-track,
.widget-content::-webkit-scrollbar-track,
.comments-content::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.05);
  border-radius: 4px;
}

.post-body::-webkit-scrollbar-thumb,
.widget-content::-webkit-scrollbar-thumb,
.comments-content::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 4px;
}

.post-body::-webkit-scrollbar-thumb:hover,
.widget-content::-webkit-scrollbar-thumb:hover,
.comments-content::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 0, 0, 0.4);
}

/* Modo oscuro */
.is-dark body::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
}

.is-dark body::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
}

.is-dark body::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.4);
}

.is-dark .post-body::-webkit-scrollbar-track,
.is-dark .widget-content::-webkit-scrollbar-track,
.is-dark .comments-content::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
}

.is-dark .post-body::-webkit-scrollbar-thumb,
.is-dark .widget-content::-webkit-scrollbar-thumb,
.is-dark .comments-content::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
}

.is-dark .post-body::-webkit-scrollbar-thumb:hover,
.is-dark .widget-content::-webkit-scrollbar-thumb:hover,
.is-dark .comments-content::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.4);
}

/* Ticker wrapper en modo oscuro */
.is-dark #ticker-wrapper {
  background-color: #1a1b1e;
}

/* Featured wrapper en modo oscuro */
.is-dark #featured-wrapper {
  background-color: #1a1b1e;
}

/* Ticker y Featured wrapper en modo claro */
#ticker-wrapper,
#featured-wrapper {
  background-color: #f8f9fa;
}

/* Ticker y Featured wrapper en modo claro */
#ticker-wrapper,
#featured-wrapper {
  background-color: #f8f9fa;
}

/* Search input en modo claro */
.main-search .search-form,
.mobile-search .search-form {
  background-color: #ffffff !important;
  color: #333333 !important;
}

/* Search input en modo oscuro */
.is-dark .main-search .search-form,
.is-dark .mobile-search .search-form {
  background-color: #23242a !important;
